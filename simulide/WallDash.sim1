<item itemtype="TextComponent" CircId="TextComponent-414" mainComp="false" Show_id="false" Show_Val="false" Pos="-656,-372" rotation="0" hflip="1" vflip="1" label="TextComponent-414" idLabPos="-16,-24" labelrot="0" valLabPos="-16,20" valLabRot="0" Margin="5 _px" Border="1 _px" Color="#ffffdc" Opacity="1" Font="Helvetica [Cronyx]" Font_Color="#000080" Font_Size="10 _px" Fixed_Width="false" Text="Objetivo del juego.&#xa;&#xa;Mover al jugador evitando colisiones &#xa;con paredes en movimiento, pasando&#xa;huecos y sobreviviendo el mayor&#xa;tiempo posible mientras se avanza &#xa;de nivel a nivel." />

<item itemtype="TextComponent" CircId="TextComponent-415" mainComp="false" Show_id="false" Show_Val="false" Pos="-400,-372" rotation="0" hflip="1" vflip="1" label="TextComponent-415" idLabPos="-16,-24" labelrot="0" valLabPos="-16,20" valLabRot="0" Margin="5 _px" Border="1 _px" Color="#ffffdc" Opacity="1" Font="Helvetica [Cronyx]" Font_Color="#000080" Font_Size="10 _px" Fixed_Width="false" Text="Controles.&#xa;&#xa;[Jugador]&#xa;w &#x3D mover hacia arriba&#xa;a &#x3D mover hacia la izquierda&#xa;s &#x3D mover hacia la derecha&#xa;d &#x3D mover hacia abajo" />

<item itemtype="TextComponent" CircId="TextComponent-416" mainComp="false" Show_id="false" Show_Val="false" Pos="-200,-372" rotation="0" hflip="1" vflip="1" label="TextComponent-416" idLabPos="-16,-24" labelrot="0" valLabPos="-16,20" valLabRot="0" Margin="5 _px" Border="1 _px" Color="#ffffdc" Opacity="1" Font="Helvetica [Cronyx]" Font_Color="#000080" Font_Size="10 _px" Fixed_Width="false" Text="[Ganar]&#xa;El juego no tiene final.&#xa;Pasas más y más obstáculos&#xa;&#xa;[Perder]&#xa;El jugador pierde al chocar&#xa;tres veces con paredes.&#xa;&#xa;La pantalla parpadea 1&#xa;vez al chocar y 2 veces&#xa;al perder. &#xa;&#xa;El juego se reinicia&#xa;luego de perder.&#xa;&#xa;[Reiniciar]&#xa;Para reiniciar forzosamnete&#xa;el juego, se debe apagar y &#xa;encender el PIC16F877A." />

